NODE_ENV=development
TZ=Asia/Taipei
DATABASE_URL=postgresql://nook:nook@localhost:5432/nook?schema=public
APPOINTMENT_CONFIRMATION_ENABLED=true
BOOKING_POLICY_V2_WRITES_ENABLED=true
APPOINTMENT_LIFECYCLE_ENABLED=true
GCP_PROJECT_ID=beauty-platform-dev
GCP_REGION=asia-east1
LINE_CHANNEL_ID=
AUTH_ADAPTER_MODE=disabled
MEDIA_STORAGE_MODE=disabled
# Required only when MEDIA_STORAGE_MODE=gcp. Never commit credentials or signed upload fields.
MEDIA_BUCKET=
MEDIA_TASK_QUEUE=
MEDIA_WORKER_URL=
MEDIA_TASK_INVOKER_SERVICE_ACCOUNT=
# Transactional notification delivery. Keep disabled until P3-006 staging gates pass.
NOTIFICATION_MODE=disabled
# API-only secret; leave empty while disabled. Never expose to Web or worker.
LINE_MESSAGING_CHANNEL_SECRET=
# Worker-only secret; leave empty while disabled. Never expose to Web or API.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
NOTIFICATION_TASK_QUEUE=
# Exact worker origin only; development may use http://localhost:8081. Do not add a path or query.
NOTIFICATION_WORKER_URL=
NOTIFICATION_TASK_INVOKER_SERVICE_ACCOUNT=
PUBLIC_WEB_BASE_URL=http://localhost:3000
LINE_MESSAGING_MONTHLY_CAP=
IDENTITY_PLATFORM_PROJECT_ID=
IDENTITY_PLATFORM_SERVICE_ACCOUNT_ID=
API_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Server-side Web to API URL used by /m/{slug}; deployment must set its real API origin.
API_INTERNAL_BASE_URL=http://localhost:8080
# Browser runtime config. Public identifiers only; never put LINE channel secrets or service-account keys here.
WEB_AUTH_MODE=disabled
WEB_API_PUBLIC_BASE_URL=http://localhost:8080
WEB_BOOKING_POLICY_V2_WRITES_ENABLED=true
WEB_APPOINTMENT_LIFECYCLE_ENABLED=true
LINE_LIFF_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
AUTH_LINE_EXCHANGE_GLOBAL_LIMIT=120
AUTH_LINE_EXCHANGE_TOKEN_LIMIT=5
AUTH_LINE_EXCHANGE_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_BUCKET_TTL_SECONDS=600
