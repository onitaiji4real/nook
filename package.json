{
  "name": "nook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:architecture": "eslint infra/ci/*.mjs && node --test infra/ci/check-repository-structure.test.mjs && node infra/ci/check-repository-structure.mjs && node infra/ci/check-workflows.mjs",
    "db:generate": "pnpm --filter @nook/database prisma:generate",
    "db:migrate": "pnpm --filter @nook/database prisma:migrate:deploy",
    "dev:services": "docker compose up -d postgres",
    "dev:services:down": "docker compose down",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "postinstall": "pnpm db:generate",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "prettier": "3.6.2",
    "turbo": "2.10.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
