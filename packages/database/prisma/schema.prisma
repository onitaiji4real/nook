generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityProvider {
  LINE
  GOOGLE
  EMAIL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum MerchantCategory {
  NAIL
  LASH
  BROW
  BEAUTY
  HAIR
  OTHER
}

enum MerchantVisibilityStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum MerchantVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum ServicePriceType {
  FIXED
  FROM
  RANGE
  QUOTE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum PlanBillingPeriod {
  NONE
  MONTHLY
  YEARLY
}

enum EntitlementValueType {
  INTEGER
  BOOLEAN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityExceptionType {
  TIME_OFF
  EXTRA_HOURS
  BLOCK
}

enum AvailabilityExceptionStatus {
  ACTIVE
  CANCELLED
}

enum BookingHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

enum BookingOccupancyStatus {
  ACTIVE
  RELEASED
  EXPIRED
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  MERCHANT_LINK
  MARKETPLACE
  ADMIN
  STAFF
  IMPORT
}

enum AppointmentPricingStatus {
  EXACT
  ESTIMATE
  QUOTE_REQUIRED
}

enum AppointmentPaymentStatus {
  NOT_REQUIRED
}

enum AppointmentReasonCode {
  CONSUMER_CHANGE_OF_PLANS
  CONSUMER_SCHEDULE_CONFLICT
  CONSUMER_BOOKED_ELSEWHERE
  CONSUMER_OTHER
  MERCHANT_CUSTOMER_REQUEST
  MERCHANT_STAFF_UNAVAILABLE
  MERCHANT_BUSINESS_CLOSURE
  MERCHANT_DUPLICATE
  MERCHANT_OTHER
  RESCHEDULE_SCHEDULE_CONFLICT
  RESCHEDULE_PREFERENCE_CHANGE
  RESCHEDULE_OTHER
}

enum AppointmentTransitionAction {
  CONSUMER_CANCEL
  CONSUMER_RESCHEDULE
  MERCHANT_CANCEL
  MERCHANT_CHECK_IN
  MERCHANT_COMPLETE
  MERCHANT_NO_SHOW
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationChannel {
  LINE_PUSH
  LINE_SERVICE_MESSAGE
}

enum NotificationJobStatus {
  PENDING
  DISPATCHING
  ENQUEUED
  DELIVERING
  ACCEPTED
  CANCELLED
  SKIPPED
  DEAD_LETTER
}

enum NotificationDeliveryOutcome {
  STARTED
  ACCEPTED
  REPLAYED
  RETRYABLE
  TERMINAL
  AMBIGUOUS
}

enum LineMessagingRecipientStatus {
  FOLLOWING
  BLOCKED
}

enum LineWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum NotificationProvider {
  LINE_MESSAGING
}

enum PortfolioItemStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DELETED
}

enum MediaAssetStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  displayName                 String                       @map("display_name") @db.VarChar(120)
  email                       String?                      @db.VarChar(320)
  phone                       String?                      @db.VarChar(32)
  avatarUrl                   String?                      @map("avatar_url") @db.Text
  status                      UserStatus                   @default(ACTIVE)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities                  UserIdentity[]
  memberships                 Membership[]
  auditLogs                   AuditLog[]                   @relation("AuditLogActor")
  staffProfiles               StaffProfile[]
  mediaAssets                 MediaAsset[]                 @relation("MediaAssetCreator")
  bookingHolds                BookingHold[]                @relation("BookingHoldConsumer")
  holdAttempts                BookingHoldRateAttempt[]
  appointments                Appointment[]                @relation("AppointmentConsumer")
  appointmentStatusHistory    AppointmentStatusHistory[]   @relation("AppointmentStatusActor")
  appointmentConfirmationKeys AppointmentConfirmationKey[]
  appointmentTransitionKeys   AppointmentTransitionKey[]
  notificationJobs            NotificationJob[]           @relation("NotificationConsumer")
  lineMessagingRecipient      LineMessagingRecipient?

  @@map("users")
}

model UserIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject") @db.VarChar(255)
  providerTenant  String?          @map("provider_tenant") @db.VarChar(255)
  profileJson     Json?            @map("profile_json")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "user_identities_provider_subject_key")
  @@index([userId], map: "user_identities_user_id_idx")
  @@map("user_identities")
}

model Tenant {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String                       @db.VarChar(160)
  slug                        String                       @unique @db.VarChar(100)
  status                      TenantStatus                 @default(ACTIVE)
  planId                      String?                      @map("plan_id") @db.Uuid
  subscriptionStatus          SubscriptionStatus           @default(FREE) @map("subscription_status")
  usageTimezone               String                       @default("Asia/Taipei") @map("usage_timezone") @db.VarChar(64)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                 Membership[]
  auditLogs                   AuditLog[]
  merchantProfile             MerchantProfile?
  locations                   Location[]
  services                    Service[]
  staffProfiles               StaffProfile[]
  staffServices               StaffService[]
  weeklyAvailabilityRules     WeeklyAvailabilityRule[]
  availabilityExceptions      AvailabilityException[]
  portfolioItems              PortfolioItem[]
  portfolioTags               PortfolioTag[]
  mediaAssets                 MediaAsset[]
  bookingPolicy               BookingPolicy?
  bookingHolds                BookingHold[]
  bookingOccupancies          BookingOccupancy[]
  appointments                Appointment[]
  appointmentItems            AppointmentItem[]
  appointmentStatusHistory    AppointmentStatusHistory[]
  appointmentConfirmationKeys AppointmentConfirmationKey[]
  appointmentTransitionKeys   AppointmentTransitionKey[]
  outboxEvents                OutboxEvent[]
  notificationJobs            NotificationJob[]
  plan                        Plan?                        @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("tenants")
}

model BookingPolicy {
  tenantId                      String   @id @map("tenant_id") @db.Uuid
  revision                      Int      @default(1)
  slotIntervalMinutes           Int      @default(15) @map("slot_interval_minutes")
  minimumLeadMinutes            Int      @default(120) @map("minimum_lead_minutes")
  maximumAdvanceDays            Int      @default(60) @map("maximum_advance_days")
  consumerCancelLeadMinutes     Int      @default(1440) @map("consumer_cancel_lead_minutes")
  consumerRescheduleLeadMinutes Int      @default(1440) @map("consumer_reschedule_lead_minutes")
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("booking_policies")
}

model MerchantProfile {
  tenantId           String                     @id @map("tenant_id") @db.Uuid
  category           MerchantCategory
  description        String?                    @db.VarChar(2000)
  phone              String?                    @db.VarChar(32)
  lineOaUrl          String?                    @map("line_oa_url") @db.Text
  instagramUrl       String?                    @map("instagram_url") @db.Text
  bookingPolicy      String?                    @map("booking_policy") @db.VarChar(2000)
  cancellationPolicy String?                    @map("cancellation_policy") @db.VarChar(2000)
  visibilityStatus   MerchantVisibilityStatus   @default(DRAFT) @map("visibility_status")
  verificationStatus MerchantVerificationStatus @default(UNVERIFIED) @map("verification_status")
  primaryLocationId  String?                    @map("primary_location_id") @db.Uuid
  starterServiceId   String?                    @map("starter_service_id") @db.Uuid
  publishedAt        DateTime?                  @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryLocation    Location?                  @relation("MerchantPrimaryLocation", fields: [tenantId, primaryLocationId], references: [tenantId, id], onDelete: NoAction)
  starterService     Service?                   @relation("MerchantStarterService", fields: [tenantId, starterServiceId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, primaryLocationId], map: "merchant_profiles_primary_location_key")
  @@unique([tenantId, starterServiceId], map: "merchant_profiles_starter_service_key")
  @@map("merchant_profiles")
}

model Location {
  id                 String                                 @id @default(uuid()) @db.Uuid
  tenantId           String                                 @map("tenant_id") @db.Uuid
  name               String                                 @db.VarChar(120)
  addressText        String                                 @map("address_text") @db.VarChar(500)
  postalCode         String?                                @map("postal_code") @db.VarChar(10)
  city               String                                 @db.VarChar(80)
  district           String                                 @db.VarChar(80)
  geoPoint           Unsupported("geography(Point, 4326)")? @map("geo_point")
  timezone           String                                 @default("Asia/Taipei") @db.VarChar(64)
  isPublicAddress    Boolean                                @default(false) @map("is_public_address")
  status             LocationStatus                         @default(ACTIVE)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryForMerchant MerchantProfile?                       @relation("MerchantPrimaryLocation")
  staffProfiles      StaffProfile[]
  bookingHolds       BookingHold[]
  appointments       Appointment[]

  @@unique([tenantId, id], map: "locations_tenant_id_id_key")
  @@index([tenantId, status], map: "locations_tenant_status_idx")
  @@map("locations")
}

model Service {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  name                String            @db.VarChar(160)
  description         String?           @db.VarChar(2000)
  durationMinutes     Int               @map("duration_minutes")
  bufferBeforeMinutes Int               @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int               @default(0) @map("buffer_after_minutes")
  priceType           ServicePriceType  @map("price_type")
  priceAmount         Int?              @map("price_amount")
  priceMin            Int?              @map("price_min")
  priceMax            Int?              @map("price_max")
  currency            String            @default("TWD") @db.Char(3)
  bookingEnabled      Boolean           @default(true) @map("booking_enabled")
  status              ServiceStatus     @default(ACTIVE)
  sortOrder           Int               @default(0) @map("sort_order")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  starterForMerchant  MerchantProfile?  @relation("MerchantStarterService")
  staffAssignments    StaffService[]
  portfolioItems      PortfolioItem[]
  bookingHolds        BookingHold[]
  appointmentItems    AppointmentItem[]

  @@unique([tenantId, id], map: "services_tenant_id_id_key")
  @@index([tenantId, status, bookingEnabled], map: "services_tenant_status_booking_idx")
  @@index([tenantId, sortOrder, id], map: "services_tenant_sort_idx")
  @@map("services")
}

model StaffProfile {
  id             String                   @id @default(uuid()) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  userId         String?                  @map("user_id") @db.Uuid
  locationId     String                   @map("location_id") @db.Uuid
  displayName    String                   @map("display_name") @db.VarChar(120)
  bio            String?                  @db.VarChar(2000)
  bookingEnabled Boolean                  @default(true) @map("booking_enabled")
  sortOrder      Int                      @default(0) @map("sort_order")
  status         StaffStatus              @default(ACTIVE)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  location       Location                 @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  services       StaffService[]
  weeklyRules    WeeklyAvailabilityRule[]
  exceptions     AvailabilityException[]
  portfolioItems PortfolioItem[]
  bookingHolds   BookingHold[]
  occupancies    BookingOccupancy[]
  appointments   Appointment[]

  @@unique([tenantId, id], map: "staff_profiles_tenant_id_id_key")
  @@index([tenantId, status, bookingEnabled], map: "staff_profiles_tenant_status_booking_idx")
  @@index([tenantId, sortOrder, id], map: "staff_profiles_tenant_sort_idx")
  @@index([userId], map: "staff_profiles_user_id_idx")
  @@map("staff_profiles")
}

model StaffService {
  tenantId              String       @map("tenant_id") @db.Uuid
  staffId               String       @map("staff_id") @db.Uuid
  serviceId             String       @map("service_id") @db.Uuid
  customDurationMinutes Int?         @map("custom_duration_minutes")
  customPriceAmount     Int?         @map("custom_price_amount")
  staff                 StaffProfile @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  service               Service      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, staffId, serviceId])
  @@index([tenantId, serviceId], map: "staff_services_tenant_service_idx")
  @@map("staff_services")
}

model WeeklyAvailabilityRule {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  staffId    String       @map("staff_id") @db.Uuid
  weekday    Int
  startTime  DateTime     @map("start_time") @db.Time(0)
  endTime    DateTime     @map("end_time") @db.Time(0)
  validFrom  DateTime     @map("valid_from") @db.Date
  validUntil DateTime?    @map("valid_until") @db.Date
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff      StaffProfile @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id], map: "weekly_availability_rules_tenant_id_id_key")
  @@index([tenantId, staffId, weekday, validFrom], map: "weekly_rules_staff_weekday_idx")
  @@map("weekly_availability_rules")
}

model AvailabilityException {
  id        String                      @id @default(uuid()) @db.Uuid
  tenantId  String                      @map("tenant_id") @db.Uuid
  staffId   String                      @map("staff_id") @db.Uuid
  type      AvailabilityExceptionType
  startAt   DateTime                    @map("start_at") @db.Timestamptz(6)
  endAt     DateTime                    @map("end_at") @db.Timestamptz(6)
  reason    String?                     @db.VarChar(500)
  status    AvailabilityExceptionStatus @default(ACTIVE)
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     StaffProfile                @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id], map: "availability_exceptions_tenant_id_id_key")
  @@index([tenantId, staffId, status, startAt, endAt], map: "availability_exceptions_staff_range_idx")
  @@map("availability_exceptions")
}

model BookingHold {
  id                                    String            @id @default(uuid()) @db.Uuid
  tenantId                              String            @map("tenant_id") @db.Uuid
  locationId                            String            @map("location_id") @db.Uuid
  serviceId                             String            @map("service_id") @db.Uuid
  staffId                               String            @map("staff_id") @db.Uuid
  consumerUserId                        String            @map("consumer_user_id") @db.Uuid
  status                                BookingHoldStatus @default(ACTIVE)
  startAt                               DateTime          @map("start_at") @db.Timestamptz(6)
  endAt                                 DateTime          @map("end_at") @db.Timestamptz(6)
  serviceNameSnapshot                   String            @map("service_name_snapshot") @db.VarChar(160)
  staffDisplayNameSnapshot              String            @map("staff_display_name_snapshot") @db.VarChar(120)
  durationMinutesSnapshot               Int               @map("duration_minutes_snapshot")
  priceTypeSnapshot                     ServicePriceType  @map("price_type_snapshot")
  priceAmountSnapshot                   Int?              @map("price_amount_snapshot")
  priceMinSnapshot                      Int?              @map("price_min_snapshot")
  priceMaxSnapshot                      Int?              @map("price_max_snapshot")
  currencySnapshot                      String            @map("currency_snapshot") @db.Char(3)
  source                                AppointmentSource @default(MERCHANT_LINK)
  bookingPolicySnapshot                 String?           @map("booking_policy_snapshot") @db.VarChar(2000)
  cancellationPolicySnapshot            String?           @map("cancellation_policy_snapshot") @db.VarChar(2000)
  consumerCancelLeadMinutesSnapshot     Int               @default(1440) @map("consumer_cancel_lead_minutes_snapshot")
  consumerRescheduleLeadMinutesSnapshot Int               @default(1440) @map("consumer_reschedule_lead_minutes_snapshot")
  policyVersion                         String?           @map("policy_version") @db.VarChar(67)
  locationNameSnapshot                  String?           @map("location_name_snapshot") @db.VarChar(120)
  addressTextSnapshot                   String?           @map("address_text_snapshot") @db.VarChar(500)
  postalCodeSnapshot                    String?           @map("postal_code_snapshot") @db.VarChar(10)
  citySnapshot                          String?           @map("city_snapshot") @db.VarChar(80)
  districtSnapshot                      String?           @map("district_snapshot") @db.VarChar(80)
  locationTimezoneSnapshot              String?           @map("location_timezone_snapshot") @db.VarChar(64)
  expiresAt                             DateTime          @map("expires_at") @db.Timestamptz(6)
  idempotencyKeyHash                    String            @map("idempotency_key_hash") @db.Char(64)
  requestFingerprint                    String            @map("request_fingerprint") @db.Char(64)
  createdAt                             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location                              Location          @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  service                               Service           @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  staff                                 StaffProfile      @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  consumer                              User              @relation("BookingHoldConsumer", fields: [consumerUserId], references: [id], onDelete: Restrict)
  occupancy                             BookingOccupancy?
  appointment                           Appointment?

  @@unique([tenantId, id], map: "booking_holds_tenant_id_id_key")
  @@unique([tenantId, staffId, id], map: "booking_holds_tenant_staff_id_key")
  @@unique([tenantId, consumerUserId, id], map: "booking_holds_tenant_consumer_id_key")
  @@unique([consumerUserId, idempotencyKeyHash], map: "booking_holds_consumer_idempotency_key")
  @@index([tenantId, staffId, status, expiresAt], map: "booking_holds_staff_status_expiry_idx")
  @@index([tenantId, consumerUserId, status, expiresAt], map: "booking_holds_consumer_status_expiry_idx")
  @@map("booking_holds")
}

model BookingOccupancy {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  staffId         String                 @map("staff_id") @db.Uuid
  holdId          String?                @unique @map("hold_id") @db.Uuid
  appointmentId   String?                @unique @map("appointment_id") @db.Uuid
  status          BookingOccupancyStatus @default(ACTIVE)
  occupiedStartAt DateTime               @map("occupied_start_at") @db.Timestamptz(6)
  occupiedEndAt   DateTime               @map("occupied_end_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff           StaffProfile           @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  hold            BookingHold?           @relation(fields: [holdId], references: [id], onDelete: Restrict)
  appointment     Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "booking_occupancies_tenant_id_id_key")
  @@index([tenantId, staffId, status, occupiedStartAt, occupiedEndAt], map: "booking_occupancies_staff_range_idx")
  @@map("booking_occupancies")
}

model Appointment {
  id                                    String                       @id @default(uuid()) @db.Uuid
  tenantId                              String                       @map("tenant_id") @db.Uuid
  locationId                            String                       @map("location_id") @db.Uuid
  staffId                               String                       @map("staff_id") @db.Uuid
  consumerUserId                        String                       @map("consumer_user_id") @db.Uuid
  holdId                                String                       @unique @map("hold_id") @db.Uuid
  status                                AppointmentStatus            @default(CONFIRMED)
  source                                AppointmentSource
  pricingStatus                         AppointmentPricingStatus     @map("pricing_status")
  paymentStatus                         AppointmentPaymentStatus     @default(NOT_REQUIRED) @map("payment_status")
  startAt                               DateTime                     @map("start_at") @db.Timestamptz(6)
  endAt                                 DateTime                     @map("end_at") @db.Timestamptz(6)
  confirmedAt                           DateTime                     @map("confirmed_at") @db.Timestamptz(6)
  usageTimezoneSnapshot                 String                       @map("usage_timezone_snapshot") @db.VarChar(64)
  usageMonth                            String                       @map("usage_month") @db.Char(7)
  locationTimezoneSnapshot              String                       @map("location_timezone_snapshot") @db.VarChar(64)
  currency                              String                       @db.Char(3)
  subtotalAmount                        Int?                         @map("subtotal_amount")
  depositAmount                         Int                          @default(0) @map("deposit_amount")
  totalAmount                           Int?                         @map("total_amount")
  bookingPolicySnapshot                 String                       @map("booking_policy_snapshot") @db.VarChar(2000)
  cancellationPolicySnapshot            String                       @map("cancellation_policy_snapshot") @db.VarChar(2000)
  consumerCancelLeadMinutesSnapshot     Int                          @default(1440) @map("consumer_cancel_lead_minutes_snapshot")
  consumerRescheduleLeadMinutesSnapshot Int                          @default(1440) @map("consumer_reschedule_lead_minutes_snapshot")
  policyVersion                         String                       @map("policy_version") @db.VarChar(67)
  policiesAcceptedAt                    DateTime                     @map("policies_accepted_at") @db.Timestamptz(6)
  locationNameSnapshot                  String                       @map("location_name_snapshot") @db.VarChar(120)
